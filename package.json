{
  "name": "meetai-productivity-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "MeetAI - local-first personal AI meeting assistant: React + Express + MongoDB + Playwright + FFmpeg + local Whisper + Ollama/Llama 3, with optional Gmail and Notion integrations.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "dev:client": "vite",
    "dev:server": "nodemon --watch server/src --watch server/scripts --ext js,mjs,cjs,json --ignore browser-profile/ --ignore recordings/ --ignore logs/ --ignore transcripts/ server/src/index.js",
    "start": "node server/src/index.js",
    "start:server": "node server/src/index.js",
    "connect:browser": "node server/scripts/connectBrowser.js",
    "check:local": "node server/scripts/checkLocalStack.js",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.2",
    "axios": "^1.7.8",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "framer-motion": "^11.13.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.3",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.16",
    "playwright": "^1.46.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-icons": "^5.3.0",
    "react-router-dom": "^7.0.1",
    "recharts": "^2.13.3",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "nodemon": "^3.1.7",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
